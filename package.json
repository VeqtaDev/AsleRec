{
  "name": "aslerec",
  "version": "1.0.0",
  "description": "AsleRec — enregistreur d'écran simple, rapide et élégant pour Windows.",
  "productName": "AsleRec",
  "main": "./out/main/index.js",
  "author": {
    "name": "VeqtaDev",
    "email": "louismonier13@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run icons && npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run icons && npm run build && electron-builder --win --dir --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
